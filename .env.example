# Copy to .env and fill in. .env is gitignored.
# Local offline demo (devtools/mock_crm.py + devtools/site_mirror.py):
WEBSITE_BASE_URL=http://127.0.0.1:8200
CRM_BASE_URL=http://127.0.0.1:8100/api/v1
CRM_BROWSER_URL=http://127.0.0.1:8100/crm
CRM_TOKEN=mock_local_token
# Real sandbox: set the three URLs to the exercise's website / API base / CRM browser,
# put your personal token in CRM_TOKEN and set ALLOW_REMOTE=1.
# The real CRM browser URL includes your token: CRM_BROWSER_URL=https://<host>/crm/<your token>
# (the review app links to $CRM_BROWSER_URL/accounts/<account_id>).
# ALLOW_REMOTE=1
